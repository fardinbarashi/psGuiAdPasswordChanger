<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="psGuiAdPasswordChanger" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue"  Color="#1E76BE"/>
    <SolidColorBrush x:Key="Blue2" Color="#175C96"/>
    <SolidColorBrush x:Key="Green" Color="#2FA84F"/>
    <SolidColorBrush x:Key="Red"   Color="#DC2626"/>
    <SolidColorBrush x:Key="Line"  Color="#E1E7EF"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="{StaticResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#E9EEF4"/>
      <Setter Property="Foreground" Value="#334155"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- ===================== HEADER ===================== -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Blue}" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="White" CornerRadius="8" Padding="6" Margin="0,0,12,0">
            <Image x:Name="ImgLogo" Width="34" Height="34"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Password Changer" Foreground="White" FontSize="20" FontWeight="Bold"/>
              <TextBlock x:Name="TxtVersion" Text="" Foreground="#BFDCF5" FontSize="12" FontWeight="SemiBold"
                         VerticalAlignment="Bottom" Margin="8,0,0,3" Cursor="Hand"/>
            </StackPanel>
            <TextBlock x:Name="SubtitleText" Text="Not connected" Foreground="#DCE9F6" FontSize="12"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="ChkTestMode" Content="Test mode" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" IsChecked="True"/>
          <Button x:Name="BtnConnect" Content="Connect &amp; Load AD" Background="{StaticResource Green}" Margin="0,0,8,0"/>
          <Button x:Name="BtnReload" Content="Reload AD" Style="{StaticResource Ghost}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== BODY ===================== -->
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <!-- LEFT: tree -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Show:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbShow" Width="200" SelectedIndex="0">
              <ComboBoxItem Content="Active and Disabled users"/>
              <ComboBoxItem Content="Only active users"/>
              <ComboBoxItem Content="Only disabled users"/>
            </ComboBox>
          </StackPanel>

          <!-- Global directory search (searches the whole domain, not just loaded nodes) -->
          <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtGlobalSearch" Grid.Column="0" Padding="8,6"
                     Tag="Search account in the domain - name, display name or account ( wildcard : User* )" />
            <Button x:Name="BtnSearch" Grid.Column="1" Content="Search" Margin="8,0,0,0"/>
            <Button x:Name="BtnSearchClear" Grid.Column="2" Content="Back to tree" Style="{StaticResource Ghost}"
                    Margin="6,0,0,0" Visibility="Collapsed"/>
          </Grid>

          <!-- Attribute filter: hides users in the tree that do not match -->
          <Border DockPanel.Dock="Top" Background="#F7FAFD" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Filter the tree on AD attributes" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="Left box = the AD attribute name, right box = the value it must have. Example: sAMAccountName / Ax*  or  physicalDeliveryOfficeName / Stockholm. Use * for any sequence of characters. Leave the value empty to match every account where the attribute is filled in at all. Empty rows are ignored, and an account must match every row you fill in."/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="AD attribute" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Value ( wildcard : Ax* )" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>

                <TextBox x:Name="TxtAttr1" Grid.Row="1" Grid.Column="0" Padding="6,4" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="=" Margin="8,0,8,4" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="TxtVal1"  Grid.Row="1" Grid.Column="2" Padding="6,4" Margin="0,0,0,4"/>

                <TextBox x:Name="TxtAttr2" Grid.Row="2" Grid.Column="0" Padding="6,4" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="=" Margin="8,0,8,4" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="TxtVal2"  Grid.Row="2" Grid.Column="2" Padding="6,4" Margin="0,0,0,4"/>

                <TextBox x:Name="TxtAttr3" Grid.Row="3" Grid.Column="0" Padding="6,4"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="=" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="TxtVal3"  Grid.Row="3" Grid.Column="2" Padding="6,4"/>
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnAttrFilter" Content="Apply filter" Margin="0,0,8,0"/>
                <Button x:Name="BtnAttrClear"  Content="Clear filter" Style="{StaticResource Ghost}"/>
                <TextBlock x:Name="TxtAttrInfo" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="No attribute filter active."/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Fill area: OU tree OR search results -->
          <Grid Margin="0,4,0,0">
            <TreeView x:Name="TreeAd" BorderThickness="0"/>
            <DockPanel x:Name="PnlSearchResults" Visibility="Collapsed">
              <TextBlock x:Name="TxtSearchInfo" DockPanel.Dock="Top" Foreground="{StaticResource Muted}"
                         FontSize="12" Margin="0,0,0,6" Text="Search results"/>
              <ListBox x:Name="LstSearch" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- RIGHT: controls + log -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="TxtSelectedCount" Text="Selected users: 0" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
          </Border>

          <!-- Generator -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="ChkOverride" Content="Override default password (use generator)"/>
              <StackPanel x:Name="PnlGen" Orientation="Vertical" Margin="0,8,0,0" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Length:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox x:Name="TxtLength" Width="46" Text="12" Padding="4,3" Margin="0,0,12,0"/>
                  <CheckBox x:Name="ChkUpper"   Content="A-Z"  IsChecked="True" Margin="0,0,10,0"/>
                  <CheckBox x:Name="ChkLower"   Content="a-z"  IsChecked="True" Margin="0,0,10,0"/>
                  <CheckBox x:Name="ChkDigit"   Content="0-9"  IsChecked="True" Margin="0,0,10,0"/>
                  <CheckBox x:Name="ChkSpecial" Content="!@#"  Margin="0,0,10,0"/>
                </StackPanel>
                <CheckBox x:Name="ChkSameAll" Content="Same password for all selected users" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="BtnGenerateSample" Content="Generate sample" Margin="0,0,8,0"/>
                  <TextBox x:Name="TxtSample" Width="200" Padding="6,6"
                           Tag="Type a password for all users (or Generate sample)"/>
                </StackPanel>
              </StackPanel>
              <Border Background="#F7FAFD" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="Domain password policy (GPO)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock x:Name="TxtPolicy" TextWrapping="Wrap" Foreground="#334155" FontSize="12"
                             Text="Connect to load the domain password policy."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Account options -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="ChkChangeOptions" Content="Change account options on selected"/>
              <StackPanel x:Name="PnlOpts" Margin="0,8,0,0" IsEnabled="False">
                <WrapPanel>
                  <CheckBox x:Name="ChkEnabled"    Content="Account enabled" IsChecked="True" Margin="0,0,16,6"/>
                  <CheckBox x:Name="ChkUnlock"     Content="Unlock account" Margin="0,0,16,6"/>
                  <CheckBox x:Name="ChkPne"        Content="Password never expires" Margin="0,0,16,6"/>
                  <CheckBox x:Name="ChkMustChange" Content="Must change password at next logon" Margin="0,0,16,6"/>
                </WrapPanel>
                <CheckBox x:Name="ChkNoPassword" Content="No password change - only account options"
                          FontWeight="SemiBold" Margin="0,4,0,6"/>
                <TextBlock Text="Applied to the selected users when you run What if (simulated) or the live button. Tick the box above to change only the account options and leave every password untouched."
                           Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Actions -->
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="BtnWhatIf" Content="What if ( Simulate Change Password )" Margin="0,0,8,8"/>
            <Button x:Name="BtnLive"   Content="Change password ( Live )" Background="{StaticResource Red}" Margin="0,0,8,8"/>
            <Button x:Name="BtnClear"  Content="Clear selection" Style="{StaticResource Ghost}" Margin="0,0,8,8"/>
          </WrapPanel>

          <!-- Log -->
          <Border Style="{StaticResource Card}" Background="#0F2233">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Log" Foreground="#CFE3F2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtLogSearch" Grid.Column="1" Margin="10,0,0,0" Padding="6,4"
                         Background="#173247" Foreground="White" BorderBrush="#2A506B" Tag="Search log..."/>
              </Grid>
              <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="220" IsReadOnly="True"
                       TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       Background="#0F2233" Foreground="#A7F3D0" BorderThickness="0"
                       FontFamily="Consolas" FontSize="12"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
